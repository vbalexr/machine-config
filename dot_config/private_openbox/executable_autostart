#!/bin/sh
# User autostart for Openbox

# Compositor (shadows, transparency, tear-free rendering)
picom &

# StatusNotifierItem watcher/host (bridges modern D-Bus tray icons to tint2's XEmbed systray)
snixembed --fork

# Tray applets
nm-applet &
pasystray &

# Taskbar
tint2 &

# Desktop system-stats widget
conky -c ~/.config/conky/conky.conf &
