#!/bin/sh
# Sourced by /usr/bin/openbox-session (via `. `, not exec'd) before it execs
# openbox, so anything exported here reaches openbox and every app it
# launches for the rest of the session.
#
# Forces GTK apps to use the dark Adwaita variant. Needed because this
# session has no desktop-environment settings daemon (no
# gnome-settings-daemon, no xfsettingsd) to broadcast a dark-mode
# preference: gsettings' org.gnome.desktop.interface color-scheme is
# honored by GTK4/libadwaita and portal-aware apps (see
# run_onchange_25-configure-dark-theme.sh), but older GTK3 apps -
# especially ones built on libxfce4ui, e.g. Thunar - ignore it and even
# reset gtk-application-prefer-dark-theme from gtk-3.0/settings.ini back
# to false on their own. GTK_THEME is the one signal both layers respect.
export GTK_THEME=Adwaita:dark
