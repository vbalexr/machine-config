#---- tint2rc: taskbar + systray + clock (dark theme) ----
# Kept as a full field set (based on the stock CachyOS tint2rc) because
# this tint2 build (17.0.2) segfaults on a stripped-down config that
# omits fields like taskbar_name_*, clock_*click_command, battery_*,
# mouse_* -- likely a null-pointer bug on unset string fields.
#-------------------------------------
# Backgrounds
# Background 0: Panel
rounded = 0
border_width = 0
border_sides = TBLR
background_color = #1e1e2e 95
border_color = #313244 0
background_color_hover = #1e1e2e 95
border_color_hover = #313244 0
background_color_pressed = #1e1e2e 95
border_color_pressed = #313244 0

# Background 1: Default task, Iconified task
rounded = 4
border_width = 0
border_sides = TBLR
background_color = #313244 60
border_color = #313244 0
background_color_hover = #45475a 70
border_color_hover = #45475a 0
background_color_pressed = #585b70 80
border_color_pressed = #585b70 0

# Background 2: Active task, Urgent task
rounded = 4
border_width = 0
border_sides = TBLR
background_color = #45475a 100
border_color = #45475a 0
background_color_hover = #585b70 100
border_color_hover = #585b70 0
background_color_pressed = #6c7086 100
border_color_pressed = #6c7086 0

#-------------------------------------
# Panel
panel_items = TSC
panel_size = 100% 32
panel_margin = 0 0
panel_padding = 6 0 6
panel_background_id = 0
wm_menu = 1
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 0
autohide = 0
autohide_show_timeout = 0
autohide_hide_timeout = 0.5
autohide_height = 2
strut_policy = follow_size
panel_window_name = tint2
disable_transparency = 0
mouse_effects = 1
font_shadow = 0
mouse_hover_icon_asb = 100 0 10
mouse_pressed_icon_asb = 100 0 0

#-------------------------------------
# Taskbar
taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 4 2 4
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
taskbar_hide_inactive_tasks = 0
taskbar_hide_different_monitor = 0
taskbar_hide_different_desktop = 0
taskbar_always_show_all_desktop_tasks = 0
taskbar_name_padding = 4 2
taskbar_name_background_id = 0
taskbar_name_active_background_id = 0
taskbar_name_font_color = #e3e3e3 100
taskbar_name_active_font_color = #ffffff 100
taskbar_distribute_size = 0
taskbar_sort_order = none
task_align = left

#-------------------------------------
# Task
task_text = 1
task_icon = 1
task_centered = 1
task_font = Sans 9
urgent_nb_of_blink = 100000
task_maximum_size = 200 30
task_padding = 8 2
task_tooltip = 1
task_thumbnail = 0
task_thumbnail_size = 210
task_font_color = #cdd6f4 100
task_active_font_color = #ffffff 100
task_background_id = 1
task_active_background_id = 2
task_urgent_background_id = 2
task_iconified_background_id = 1
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = close
mouse_scroll_up = toggle
mouse_scroll_down = iconify

#-------------------------------------
# System tray (notification area)
systray_padding = 4 4 6
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 20
systray_icon_asb = 100 0 0
systray_monitor = 1
systray_name_filter =

#-------------------------------------
# Clock
time1_format = %H:%M
time2_format = %A %d %B
time1_font = Sans Bold 10
time2_font = Sans 8
time1_timezone =
time2_timezone =
clock_font_color = #cdd6f4 100
clock_padding = 8 0
clock_background_id = 0
clock_tooltip =
clock_tooltip_timezone =
clock_lclick_command =
clock_mclick_command =
clock_uwheel_command =
clock_dwheel_command =

#-------------------------------------
# Battery
battery_tooltip = 1
battery_low_status = 10
battery_low_cmd = notify-send "Battery low"
battery_full_cmd =
battery_font_color = #cdd6f4 100
bat1_format =
bat2_format =
battery_padding = 1 0
battery_background_id = 0
battery_hide = 101
battery_lclick_command =
battery_rclick_command =
battery_mclick_command =
battery_uwheel_command =
battery_dwheel_command =
ac_connected_cmd =
ac_disconnected_cmd =

#-------------------------------------
# Tooltip
tooltip_show_timeout = 0.5
tooltip_hide_timeout = 0.1
tooltip_padding = 4 4
tooltip_background_id = 0
tooltip_font_color = #dddddd 100
